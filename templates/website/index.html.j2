<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <title>Academic Homepage</title>
  <style>
    body { font-family: 'Helvetica Neue', Arial, sans-serif; max-width: 50rem; margin: 2rem auto; padding: 0 1rem; line-height: 1.6; color: #222; }
    h1 { border-bottom: 2px solid #333; padding-bottom: 0.3rem; }
    h2 { color: #444; margin-top: 2rem; }
    ul { padding-left: 1.2rem; }
    li { margin-bottom: 0.5rem; }
    em { color: #555; }
    a { color: #1a6; }
  </style>
</head>
<body>

<h1>Academic Homepage</h1>

{% if bio_entries %}
<h2>Education</h2>
<ul>
{% for e in bio_entries %}
  <li><strong>{{ e.title }}</strong>{% if e.organization %} — {{ e.organization }}{% endif %}{% if e.start_date %} ({{ e.start_date.strftime('%Y') }}–{{ e.end_date.strftime('%Y') if e.end_date else 'Present' }}){% endif %}</li>
{% endfor %}
</ul>
{% endif %}

{% if publications %}
<h2>Publications</h2>
<ul>
{% for p in publications %}
  <li>
    {{ p.authors }}.
    <em>{{ p.title }}</em>.
    {% if p.venue %}{{ p.venue }}.{% endif %}
    {% if p.doi %}<a href="https://doi.org/{{ p.doi }}">DOI</a>{% endif %}
  </li>
{% endfor %}
</ul>
{% endif %}

{% if teaching %}
<h2>Teaching</h2>
<ul>
{% for t in teaching %}
  <li>{{ t.course_code }} {{ t.course_name }} ({{ t.role }}, {{ t.semester.value | capitalize }} {{ t.year }})</li>
{% endfor %}
</ul>
{% endif %}

</body>
</html>
